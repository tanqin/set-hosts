{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Set Hosts 桌面端权限",
  "platforms": ["windows", "linux", "macOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "shell:allow-execute",
    "shell:allow-open",
    "dialog:default",
    "notification:default",
    "store:default"
  ]
}
